{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: src.main",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      // This makes imports work
      "env": {
        "PYTHONPATH": "backend"
      },

      // Optional: pick up your .env
      "envFile": "${workspaceFolder}/.env",

      // Optional: enforce Pixi env interpreter
      "python": "${workspaceFolder}/backend/.pixi/envs/default/bin/python"
    }
  ]
}
