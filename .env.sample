# Public application URLs
FRONTEND_BASE_URL=http://localhost:10090/chatep/
FRONTEND_ORIGIN=http://localhost:10090
BACKEND_BASE_URL=http://localhost:10090/chatep/api

# Published Docker ports
FRONTEND_PORT=10090
BACKEND_PORT=10092
REDIS_PORT=6379
POSTGRES_PORT=5433

# Authentik OAuth application
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_DISCOVERY_URL=
OAUTH_LOGOUT_URL=
OAUTH_REDIRECT_URI=http://localhost:10090/chatep/api/auth/callback
AUTHENTIK_BASE_URL=

# Session
SESSION_SECRET=change-me-local

# Redis and PostgreSQL
REDIS_PASSWORD=change-me-local
REDIS_URL=redis://:change-me-local@localhost:6379/0
REDIS_EXPIRATION_TIME=86400
CHAT_HISTORY_LIMIT=10
STUDIO_POSTGRES_DB=studio
STUDIO_POSTGRES_USER=studio
STUDIO_POSTGRES_PASSWORD=change-me-local
POSTGRES_URL=postgresql://studio:change-me-local@studio_postgres:5432/studio

# OpenAI-compatible chat provider
OPENAI_HOST=
OPENAI_API_KEY=
LLM_MODEL=

# MCP tools
MCP_TOOL_CONFIG_PATH=mcp_tools.json
MCP_USE_OAUTH=false

# Optional observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Optional integrations
QDRANT_URL=
QDRANT_PORT=6333
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
