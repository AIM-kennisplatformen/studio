# Public application URLs
FRONTEND_BASE_URL=http://localhost:10090
BACKEND_BASE_URL=http://localhost:10090/api

# Published Docker ports (chosen not to overlap with Scepa defaults)
FRONTEND_PORT=10090
BACKEND_PORT=10092
REDIS_PORT=6379
POSTGRES_PORT=5433

# Authentik OAUTH Application
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_DISCOVERY_URL=
OAUTH_LOGOUT_URL=
OAUTH_REDIRECT_URI=http://localhost:10090/auth/callback

# Session Configuration
SESSION_SECRET=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_EXPIRATION_TIME=86400

# Chat History Configuration
CHAT_HISTORY_LIMIT=10

# Langfuse (Observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# OpenAI Configuration
OPENAI_HOST=
OPENAI_API_KEY=
LLM_MODEL=

# MCP Tool Configuration
MCP_TOOL_CONFIG_PATH=mcp_tools.json
MCP_USE_OAUTH=false
