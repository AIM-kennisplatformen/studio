  "components": {
    "schemas": {
      "Body_upload_pdf_api_pdf__sha256__put": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": ["file"],
        "title": "Body_upload_pdf_api_pdf__sha256__put"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogEventPayload": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": ["name"],
        "title": "LogEventPayload"
      },
      "Session": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "user_id": { "type": "string", "title": "User Id" },
          "name": { "type": "string", "title": "Name" },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count",
            "default": 0
          },
          "title_type": {
            "type": "string",
            "enum": ["static", "adaptive"],
            "title": "Title Type",
            "default": "adaptive"
          },
          "title_overwritten": {
            "type": "boolean",
            "title": "Title Overwritten",
            "default": false
          },
          "last_title_message_count": {
            "type": "integer",
            "title": "Last Title Message Count",
            "default": 0
          }
        },
        "type": "object",
        "required": ["session_id", "user_id", "name", "updated_at"],
        "title": "Session"
      },
      "SessionDetail": {
        "properties": {
          "session": { "$ref": "#/components/schemas/Session" },
          "messages": {
            "items": { "$ref": "#/components/schemas/SessionMessage" },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": ["session", "messages"],
        "title": "SessionDetail"
      },
      "SessionMessage": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "role": { "type": "string", "enum": ["ai", "user"], "title": "Role" },
          "content": { "type": "string", "title": "Content" },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "role",
          "content",
          "created_at",
          "updated_at"
        ],
        "title": "SessionMessage"
      },
      "UpdateSessionRequest": {
        "properties": {
          "name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Name"
          },
          "title_type": {
            "anyOf": [
              { "type": "string", "enum": ["static", "adaptive"] },
              { "type": "null" }
            ],
            "title": "Title Type"
          }
        },
        "type": "object",
        "title": "UpdateSessionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
