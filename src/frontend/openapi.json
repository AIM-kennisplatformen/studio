    "/api/pdf/{sha256}": {
      "put": {
        "tags": ["pdf"],
        "summary": "Upload Pdf",
        "description": "Store a PDF under its own sha256 content hash.\n\nsha256 is verified server-side against the uploaded bytes and rejected\non mismatch, so a given hash always maps to exactly one PDF. Re-uploading\nthe same content under its own hash is a safe no-op. Machine clients\nonly — an authorized application (e.g. scepa-rs) pushes PDFs here after\ningesting them.",
        "operationId": "upload_pdf_api_pdf__sha256__put",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Sha256" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_pdf_api_pdf__sha256__put"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["pdf"],
        "summary": "Get Pdf",
        "description": "Return the raw PDF bytes stored under sha256.\n\nReadable by both authorized applications (API key) and the frontend's\nPDF viewer (browser session) — unlike upload/delete, which stay\nmachine-only. Responses are cached indefinitely: the identifier is the\ncontent's own hash, so it can never point to different bytes later.",
        "operationId": "get_pdf_api_pdf__sha256__get",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Sha256" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["pdf"],
        "summary": "Delete Pdf",
        "description": "Delete the PDF stored under sha256. Machine clients only.",
        "operationId": "delete_pdf_api_pdf__sha256__delete",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Sha256" }
          }
        ],
        "responses": {
          "204": { "description": "Successful Response" },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
